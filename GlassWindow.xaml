<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="clr-namespace:SoundCloud.Controls;assembly=DIConverter"
 Title="DIConverter" Icon="pack://application:,,,/Assets/DIConverter.ico" Width="720" Height="550" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="pack://application:,,,/Assets/Fonts/#Special Gothic One" FontStretch="Expanded" Foreground="#FAFAFC">
 <Window.Resources>
  <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0.75,1"><GradientStop Color="#B8FFFFFF" Offset="0"/><GradientStop Color="#38FFFFFF" Offset="0.45"/><GradientStop Color="#1AFFFFFF" Offset="0.65"/><GradientStop Color="#85FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2CFFFFFF" Offset="0"/><GradientStop Color="#10FFFFFF" Offset="0.45"/><GradientStop Color="#05FFFFFF" Offset="0.7"/><GradientStop Color="#19FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="DarkGlass" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="#02000000" Offset="0.45"/><GradientStop Color="#18000000" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <glass:GlassButtonChrome x:Name="Chrome">
     <Grid>
      <Border x:Name="Focus" CornerRadius="28" Margin="2" BorderBrush="White" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7,3,7,5"/>
     </Grid>
    </glass:GlassButtonChrome>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Hover" To="1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Hover" To="0" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Press" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Press" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Padding" Value="13,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" CornerRadius="13" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Margin="3,2">
     <Grid Margin="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center"/>
      <Path x:Name="SelectedMark" Grid.Column="1" Data="M 1,5 L 4,8 L 10,1" Stroke="#F5F7FC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#20FFFFFF"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#30FFFFFF"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#32FFFFFF"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#55FFFFFF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Height" Value="46"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="Selector" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <glass:GlassButtonChrome x:Name="Chrome"><Grid Background="Transparent">
        <Border x:Name="FocusRim" CornerRadius="22" Margin="3" BorderBrush="#A6FFFFFF" BorderThickness="1" Opacity="0"/>
       </Grid></glass:GlassButtonChrome>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
         <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Hover" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
         <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Hover" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="FocusRim" Property="Opacity" Value="0.7"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="18,0,38,2" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0" Stroke="#DAE0EB" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,2" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
     <Border x:Name="KeyboardRim" CornerRadius="22" Margin="3" BorderBrush="#BFFFFFFF" BorderThickness="1" Visibility="Hidden" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#F21E222B" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="19" Padding="4,5">
       <ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="KeyboardRim" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#787B96C2"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.45" Color="#000000"/></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="MaterialRoot">
  <Border x:Name="Shell" CornerRadius="32" Background="#78040507"/>
  <Border CornerRadius="32" Background="{StaticResource DarkGlass}" IsHitTestVisible="False"/>
  <Grid x:Name="ContentLayer">
   <Grid Height="38" VerticalAlignment="Top" Margin="32,24,26,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="pack://application:,,,/Assets/DIConverter-logo.png" Width="38" Height="38" Stretch="Uniform" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock x:Name="BrandText" Text="DIConverter" FontSize="19" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="Minimize" Content="−" Width="34" Height="34" Margin="0,0,9,0" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
     <Button x:Name="CloseWindow" Content="×" Width="34" Height="34" FontSize="18" ToolTip="Close" AutomationProperties.Name="Close"/>
    </StackPanel>
   </Grid>
   <StackPanel Margin="44,88,44,24">
    <TextBlock Text="Video or track link" Foreground="#E5E8EF" FontSize="12" Margin="4,0,0,9"/>
    <Border x:Name="LinkSurface" CornerRadius="22" Background="#26040912" BorderBrush="#65FFFFFF" BorderThickness="1" Height="56">
     <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Data="M 5,13 L 5,9 C 5,3 15,3 15,9 L 15,12 M 10,9 L 10,14 C 10,20 20,20 20,14 L 20,10" Stroke="#D9DFEA" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="25" Height="24" VerticalAlignment="Center"/>
      <TextBox x:Name="Link" Grid.Column="1" AutomationProperties.Name="YouTube or SoundCloud link" ToolTip="https://soundcloud.com/artist/track"/>
      <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Paste a YouTube or SoundCloud link" Foreground="#C4CDD9" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="Save" Foreground="#E5E8EF" FontSize="12" Margin="4,0,0,8"/><ComboBox x:Name="MediaMode" SelectedIndex="0" AutomationProperties.Name="Media type"><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Video"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Format" Foreground="#E5E8EF" FontSize="12" Margin="4,0,0,8"/><ComboBox x:Name="MediaFormat" AutomationProperties.Name="File format"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Quality" Foreground="#E5E8EF" FontSize="12" Margin="4,0,0,8"/><ComboBox x:Name="MediaQuality" AutomationProperties.Name="Media quality"/></StackPanel>
    </Grid>
    <TextBlock Text="Save to" Foreground="#E5E8EF" FontSize="12" Margin="4,23,0,9"/>
    <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="123"/></Grid.ColumnDefinitions>
     <Border CornerRadius="21" Background="#21040912" BorderBrush="#45FFFFFF" BorderThickness="1" Margin="0,0,12,0">
      <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Path Data="M 2,6 L 8,6 L 10,8 L 21,8 L 21,19 L 2,19 Z" Stroke="#D5DCE6" StrokeThickness="1.2" Width="23" Height="24" VerticalAlignment="Center"/>
       <TextBlock x:Name="Folder" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="#E0E5ED"/>
      </Grid>
     </Border>
     <Button x:Name="Browse" Grid.Column="1" Content="Browse…"/>
    </Grid>
    <Button x:Name="Download" Height="56" Margin="0,27,0,0" IsDefault="True" AutomationProperties.Name="Download">
     <StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="20" Margin="0,-3,10,0"/><TextBlock Text="Download" FontSize="15" FontWeight="SemiBold"/></StackPanel>
    </Button>
    <ProgressBar x:Name="Progress" Height="2" Margin="15,11,15,0" Visibility="Hidden" IsIndeterminate="True" Foreground="#E6EDFA" Background="#20FFFFFF" BorderThickness="0"/>
    <TextBlock x:Name="Status" Text="homerick" TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="#D3DAE5" FontSize="11" Margin="0,10,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
